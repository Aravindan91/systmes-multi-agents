<?xml version="1.0" encoding="utf-8"?>
<model version="NetLogo 7.0.3" snapToGrid="true">
  <code><![CDATA[;; les var de case en f de leurs "typ"
patches-own [
  is-obstacle?          
  pheromone              
  idleness               
  propagated-idleness   ;;c'est pour Cling , c cette var qui repend l'oisivité
  propagated-buffer      ;; pour le calcul 
  reachable?            ;;  pour Map C 
]

;; Ici on declare que les var globale ( commun a tous )
globals [
  execution-time  ;; le temps de la derniere exp
  stop-simulation? ;; var pour stopper 
]

;; nos agents 
turtles-own [
  last-dx  
  last-dy  
]



;; --- etape1 : les mesures ---
;; calculer la valeur de IGI et IWI 

;; IGI = moyenne des idleness 
to-report igi
  report mean [idleness] of patches with [not is-obstacle?]
end

;; IWI = pire idleness 
to-report iwi
  report max [idleness] of patches with [not is-obstacle?]
end


;; --- etape2 : MAP ---
to setup-map
  if map-type = "MapA" [ setup-map-A stop ]
  ;;si en selectionne Mapi dans le tiroir ,
  ;; on le genere puis on sore de la procedure 

  if map-type = "MapB" [ setup-map-B stop ]
  if map-type = "MapC" [ setup-map-C stop ]
  if map-type = "MapD" [ setup-map-D stop ]
  if map-type = "MapE" [ setup-map-E stop ]
  setup-map-A
end

;; Map A : terrain vide (aucun obstacle)
to setup-map-A
  ;; c blanc 
end

;; Map B : spirale continue
to setup-map-B
  create-turtles 1 [
    set color black
    set heading 90
    setxy min-pxcor max-pycor
    
    let longueur (world-width - 1)
    while [longueur > 0] [
      repeat 2 [
        repeat longueur [
          ask patch-here [ make-obstacle ]
          fd 1
        ]
        rt 90
      ]
      set longueur longueur - 3
    ]
    die ;; obligatoire , on doit suppr notre robot temp
  ]
end

;; Map C : env 20% obstacles
to setup-map-C
  let density 0.20
  ask patches [
    if random-float 1.0 < density [
      make-obstacle
    ]
  ]
  reparer-map
  ;;f pour eviter les zone innacessible
end

;; Map D : Couloir avc 4 pieces 
to setup-map-D
  ;; base noires en bas (environ 15% )
  let base-y round (min-pycor + (world-height * 0.15))
  ask patches with [pycor <= base-y] [ make-obstacle ]
  
  ;; la salle de départ 
  ask patches with [pycor <= base-y and pxcor >= -2 and pxcor <= 2] [ make-free ]
  
  ;; murs verticaux 
  ask patches with [pxcor = -3 or pxcor = 3] [ make-obstacle ]
  
  ;; diviser horizontales pour creer 4 zone 
  let room-h round ((max-pycor - base-y) / 4)
  ask patches with [pxcor < -3 or pxcor > 3] [
    if (pycor > base-y) and ((pycor - base-y) mod room-h = 0) [ 
      make-obstacle 
    ]
  ]
  
  ;;  portes 
  let i 0
  while [i < 4] [
    let door-y round (base-y + (i * room-h) + (room-h / 2))
    ask patches with [(pxcor = -3 or pxcor = 3) and pycor >= (door-y - 1) and pycor <= (door-y + 1)] [
      make-free
    ]
    set i i + 1
  ]
  
  ;; fermer mur tout en haut , pk ca ressemble plus a l'aricle
  ask patches with [pycor = max-pycor] [ make-obstacle ]
end

;; Map E : 3 Salles imbriquées 

to setup-map-E
  let x1 round (min-pxcor + (world-width / 3))
  let x2 round (max-pxcor - (world-width / 3))

  ;; les bordure
  ask patches with [ pxcor = min-pxcor or pxcor = max-pxcor or pycor = min-pycor or pycor = max-pycor ] [ 
    make-obstacle 
  ]

  ;; 2. Murs verticau qui sep en 3 collone
  ask patches with [pxcor = x1 or pxcor = x2] [ make-obstacle ]

  ;;  Portes verticaux

  ask patches with [pxcor = x1 and pycor >= (max-pycor - 3)] [ make-free ]

  ask patches with [pxcor = x2 and pycor <= (min-pycor + 3)] [ make-free ]

  ;; Murs horizontaux 
  ask patches with [pycor = 0 or pycor = 1] [ make-obstacle ]

  ;; ouverture dans les mure horizentaux
  ask patches with [pxcor < x1 and pxcor >= (x1 - 3) and (pycor = 0 or pycor = 1)] [ make-free ]
  
  ;; le 2eme ouverture
  ask patches with [pxcor > x1 and pxcor <= (x2 - 3) and (pycor = 0 or pycor = 1)] [ make-free ]
  
  ;; la dernier ouverture
  ask patches with [pxcor > x2 and pxcor <= (x2 + 3) and (pycor = 0 or pycor = 1)] [ make-free ]
end

;;--raccourci code pour les obstacle ( au lieux d'ecrire les meme ligne de code , on utilise ces procedure)

to make-obstacle  ;; patch procedure
  set is-obstacle? true
  set pcolor black
  set idleness 0
end

to make-free  ;; patch procedure
  set is-obstacle? false
  set pcolor white
end

to reparer-map
;;f qui permet d'eviter les zone innacessible , on choisit au hasare une case blanche 
;;et on propage le signale aux case voisin, ceux qui n'ont pas eu le signale , devienne obstacle 
;;repeter
  ask patches [ set reachable? false ]
  let start one-of patches with [not is-obstacle?]
  if start = nobody [ stop ]

  ask start [ set reachable? true ]
  
  let any-changed? true
  while [any-changed?] [
    let candidates patches with [not reachable? and not is-obstacle? and any? neighbors4 with [reachable?]]
    set any-changed? any? candidates
    ask candidates [ set reachable? true ]
  ]

  ask patches with [(not is-obstacle?) and (not reachable?)] [
    make-obstacle
  ]
end

to setup  
  clear-all 
  
  ;;q-max et evap-rate sont  gérées par curseurs (interface)
  
  ;; Initialisation des cases a blanc
  ask patches [
    set is-obstacle? false
    set pheromone 0
    set idleness 0
    set propagated-idleness 0
    set propagated-buffer 0
    set pcolor white  
  ]

  set execution-time 0  ;; reset du temps
  set stop-simulation? false ;; On reactive la possibilite de simuler

  ;; step2 : generer les map 
  setup-map
  
  ;; robots en orange
  create-turtles population-size [
    set shape "default"
    set size 1.0  
    set color orange
    
    set last-dx 0 
    set last-dy 0
    
   
    let spawn one-of patches with [ (not is-obstacle?) and (not any? turtles-here) ]
    if spawn != nobody [
      move-to spawn
    ]
    ;; case départ est visitée
    ask patch-here [ set idleness 0 ]
  ]
  
  ;; Demarrage du chrono et timer
  reset-ticks
  reset-timer  
end

;; --- le moteur de la simu ---

to go
  ;; c mon boutton urgence , ( qui marche pas vrm , pas pour tt les run )
  if stop-simulation? = true [ stop ]

  ;; idleness +1 sur tt les cases a chaque tick
  ask patches with [not is-obstacle?] [
    set idleness idleness + 1
  ]

  ;; on choisi l'actio de nos robots en f de l'algo chousit 
  ifelse algorithm-type = "EVAP" [
    evaporate-pheromones
    ask turtles [ move-agent-evap ]
  ] [

    propagate-idleness
    ask turtles [ move-agent-cling ]
  ]

  update-display

  tick
end

;; --- pour les test , c le bouton autoatisation ( on automatise 5 test , et on fiat la moyenne---

;;l'action
to run-experiment
  reset-timer
  
  while [ticks < 4000] [
    if stop-simulation? = true [ 
      print "!!! INTERRUPTION MANUELLE (Run) !!!"
      stop 
    ]
    go
    ;; on affiche tt les 500 ticks pour montrer que ca continue 
    if ticks mod 500 = 0 [ display ]
  ]
  
  ;; tps final
  set execution-time timer 
  
  print (word "   > Run terminé en " precision execution-time 2 "s | IGI: " precision igi 2 " | IWI: " precision iwi 2)
end

;; --- on lance notre procedure 5 fois  ---
to run-full-series
  let igi-results []
  let iwi-results []
  let time-results []
  
  print "=================================================="
  print (word "DÉMARRAGE DE LA SÉRIE (5 RUNS) - " algorithm-type " sur " map-type)
  print (word "Population : " population-size)
  
  repeat 5 [
    if stop-simulation? = true [ stop ]
    setup
    run-experiment
    
    if stop-simulation? = true [ stop ]
    
    set igi-results lput igi igi-results
    set iwi-results lput iwi iwi-results
    set time-results lput execution-time time-results
  ]
  
  if stop-simulation? = true [ 
    print "!!! SÉRIE ARRÊTÉE PAR L'UTILISATEUR !!!"
    stop 
  ]
  
  print "--------------------------------------------------"
  print "RÉSULTATS MOYENS FINAUX :"
  print (word "Moyenne IGI : " precision (mean igi-results) 2)
  print (word "Moyenne IWI : " precision (mean iwi-results) 2)
  print (word "Moyenne Temps : " precision (mean time-results) 2 " secondes")
  print "=================================================="
end

;; --- le bouton d urgence qui marche pas pr l'instant  ---
to force-stop
  set stop-simulation? true
  print "Demande d'arrêt envoyée... (attente de la fin du tick actuel)"
end

;; --- EVAP  ---
;;la logique evape 
to evaporate-pheromones
  ask patches with [not is-obstacle?] [
    if pheromone > 0 [
      ;; On diminue la phéromone selon le taux du curseur
      set pheromone pheromone * (1 - evaporation-rate)
      ;;  pour  pas descendre en dessous de 0
      if pheromone < 0.01 [ set pheromone 0 ]
    ]
  ]
end

;;l'action que les robots vont faire 
to move-agent-evap
  ;;cases voisines libres  non occupées
  let options neighbors4 with [ (not is-obstacle?) and (not any? turtles-here) ]

  if any? options [
    ;;  trouver valeur min pheromone
    let m min [pheromone] of options
    ;; isoler les meilleures cases ( qui sentent le moins)
    let best-neighbors options with [pheromone = m]
    
    let target nobody
    
    ;; Momentum : essayer de continuer tout droit

    let ahead patch-at last-dx last-dy
    ;; Si la case devant fait partie des meilleures, on la garde avec probabilité p-momentum
    if ahead != nobody and any? best-neighbors with [self = ahead] [
      if random-float 1.0 < p-momentum [
        set target ahead
      ]
    ]
    
    ;; on prend parmi les meilleures cases
    if target = nobody [
      set target one-of best-neighbors
    ]
    
    ;; on deplace 
    let old-patch patch-here
    move-to target
    set last-dx pxcor - [pxcor] of old-patch
    set last-dy pycor - [pycor] of old-patch
    
    ;; depot  pheromone et reset oisivete
    ask patch-here [
      set pheromone q-max
      set idleness 0
    ]
  ]
end

;; ---  CLInG  ---

to propagate-idleness
  ;; c ici qu'on utilise le buffer :  propagted-buffer , très important 
  ask patches with [not is-obstacle?] [

    let max-neighbor-contribution 0 ;; résultat du calcul du radar
    let candidates neighbors4 with [not is-obstacle?]
    
    if any? candidates [
      ;;on applique la formule max ( OP_voisin - alpha - beta * I_voisin )
      set max-neighbor-contribution max [
        propagated-idleness - alpha - (ifelse-value any? turtles-here [ beta ] [ 0 ])
                               ;;si y a un robot , on envoie beta , sinon 0 comme valeur 
      ] of candidates
    ]
    
    ;; le signal local est soit sa propre idleness, soit la meilleure contribution recu des autre case 
    let candidate-op max (list idleness max-neighbor-contribution)
    
    ;; pour eviter les valeur negative
    set propagated-buffer max (list op-min candidate-op)
  ]
  
  ;; on valide le buffer
  ask patches with [not is-obstacle?] [
    set propagated-idleness propagated-buffer
  ]
end

to move-agent-cling
  let options neighbors4 with [ (not is-obstacle?) and (not any? turtles-here) ]

  if any? options [
    ;; on cherhce l'oisiveté max , qu'on propagera 
    let m max [propagated-idleness] of options
    
    let best-neighbors options with [propagated-idleness = m]
    
    let target one-of best-neighbors
    
    move-to target
    ask patch-here [
      set idleness 0
      set propagated-idleness 0
    ]
  ]
end


to update-display
  ask patches [
    ifelse is-obstacle? [
      set pcolor black  
    ] [
      ifelse algorithm-type = "EVAP" [
        ifelse pheromone > 0.1 [
          set pcolor scale-color sky pheromone (q-max * 2) 0
        ] [
          set pcolor white
        ]
      ] [
        ifelse propagated-idleness > 1 [
          set pcolor scale-color orange propagated-idleness 200 0
        ] [
          set pcolor white
        ]
      ]
    ]
  ]
end]]></code>
