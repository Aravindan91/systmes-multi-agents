    <monitor x="220" precision="0" y="375" height="60" units="ticks" fontSize="11" width="100" display="INI exemple">ifelse-value any? turtles [ [idleness] of one-of patches with [any? turtles-here] ] [ 0 ]</monitor>
    <slider x="85" step="0.001" y="480" max="0.1" width="250" display="evaporation-rate" height="50" min="0" direction="Horizontal" default="0.01" variable="evaporation-rate"></slider>
