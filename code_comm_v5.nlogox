    <slider x="90" step="0.05" y="625" max="1" width="250" display="p-momentum" height="50" min="0" direction="Horizontal" default="0.8" variable="p-momentum"></slider>
    <plot x="800" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="idleness" y="10" xMin="0.0" height="385" legend="true" xMax="10.0" yMin="0.0" width="690" xAxis="ticks" display="evolution de l oivisite ( idleness">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="0" display="IGI (Moyenne)" color="-13345367" legend="true">
        <setup></setup>
        <update>plot igi</update>
      </pen>
      <pen interval="1.0" mode="0" display="IWI" color="-2674135" legend="true">
        <setup></setup>
        <update>plot iwi</update>
      </pen>
    </plot>
    <chooser x="405" y="440" height="60" variable="algorithm-type" current="1" width="250" display="algorithm-type">
      <choice type="string" value="EVAP"></choice>
      <choice type="string" value="CLInG"></choice>
    </chooser>
    <slider x="715" step="1" y="445" max="100" width="250" display="alpha" height="50" min="0" direction="Horizontal" default="10.0" variable="alpha"></slider>
    <slider x="720" step="1" y="520" max="100" width="250" display="beta" height="50" min="0" direction="Horizontal" default="5.0" variable="beta"></slider>
    <slider x="720" step="1" y="595" max="10" width="250" display="op-min" height="50" min="0" direction="Horizontal" default="0.0" variable="op-min"></slider>
    <monitor x="420" precision="17" y="525" height="60" units="second" fontSize="11" width="250" display="temps d'executions">execution-time</monitor>
    <button x="425" y="605" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="110">run-experiment</button>
    <button x="595" y="610" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="95">run-full-series</button>
